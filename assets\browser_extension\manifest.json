{
  "manifest_version": 3,
  "name": "Jarvix Browser Bridge",
  "version": "0.5.0",
  "description": "Explicitly connect existing browser tabs to your local Jarvix desktop assistant.",
  "permissions": ["nativeMessaging", "tabs", "tabGroups", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "optional_permissions": ["downloads"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Jarvix browser connection"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
